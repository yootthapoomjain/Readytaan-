<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ready Taan - เครื่องดื่มธัญพืช</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; }
    .serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-gray-50">

  <!-- Promo -->
  <div class="bg-amber-600 text-white text-center py-3 text-sm font-medium">
    🚚 ส่งฟรีทุกออเดอร์ • ซื้อ 3 ถุง แถมแก้วเชค Premium
  </div>

  <!-- Nav -->
  <nav class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-5 flex justify-between items-center">
      <h1 class="text-3xl font-bold text-amber-600 serif">Ready Taan</h1>
      <button onclick="toggleCart()" class="relative text-2xl">
        <i class="fas fa-shopping-cart"></i>
        <span id="cart-count" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs w-5 h-5 flex items-center justify-center rounded-full">0</span>
      </button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-amber-50 to-white py-20 text-center">
    <h2 class="text-5xl font-bold serif leading-tight">เครื่องดื่มธัญพืช<br>เพื่อสุขภาพ</h2>
    <button onclick="document.getElementById('shop').scrollIntoView({ behavior: 'smooth' })}" 
            class="mt-8 bg-amber-600 text-white px-10 py-4 rounded-full text-lg font-semibold">
      สั่งซื้อเลย
    </button>
  </section>

  <!-- Shop -->
  <section id="shop" class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-3xl font-bold text-center mb-10">เลือกซื้อสินค้า</h2>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-white rounded-3xl shadow p-6">
        <h3 class="text-xl font-semibold">Ready Taan 1 ถุง</h3>
        <p class="text-3xl font-bold text-amber-600 mt-4">฿290</p>
        <button onclick="addToCart(0)" class="mt-6 w-full bg-amber-600 text-white py-4 rounded-2xl">เพิ่มลงตะกร้า</button>
      </div>
      <div class="bg-white rounded-3xl shadow p-6 border-2 border-amber-500 relative">
        <div class="absolute top-4 right-4 bg-amber-500 text-white text-xs font-bold px-4 py-1 rounded-full">แนะนำ</div>
        <h3 class="text-xl font-semibold">Ready Taan 3 ถุง + แก้วเชค</h3>
        <p class="text-3xl font-bold text-amber-600 mt-4">฿870</p>
        <button onclick="addToCart(1)" class="mt-6 w-full bg-amber-600 text-white py-4 rounded-2xl">เพิ่มลงตะกร้า</button>
      </div>
    </div>
  </section>

  <!-- Cart Drawer -->
  <div id="cart-drawer" class="fixed inset-0 bg-black/70 hidden flex items-end z-50">
    <div class="bg-white w-full rounded-t-3xl max-w-md mx-auto h-[85vh] flex flex-col">
      <div class="p-6 border-b flex justify-between">
        <h3 class="text-2xl font-semibold">ตะกร้าสินค้า</h3>
        <button onclick="toggleCart(false)" class="text-3xl leading-none">✕</button>
      </div>
      <div id="cart-items" class="flex-1 p-6 overflow-auto"></div>
      <div class="p-6 border-t">
        <div class="flex justify-between text-xl mb-6">
          <span>ยอดรวมทั้งหมด</span>
          <span id="cart-total" class="font-bold text-2xl">฿0</span>
        </div>
        <button onclick="checkout()" class="w-full bg-green-600 text-white py-4 rounded-2xl text-lg font-semibold">
          สั่งซื้อผ่าน LINE OA
        </button>
      </div>
    </div>
  </div>

  <script>
    let cart = [];
    const products = [
      { name: "Ready Taan 1 ถุง", price: 290 },
      { name: "Ready Taan 3 ถุง + แก้วเชค", price: 870 }
    ];

    function addToCart(i) {
      const item = products[i];
      const existing = cart.find(x => x.name === item.name);
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({ ...item, qty: 1 });
      }
      updateCart();
      toggleCart(true);
    }

    function updateCart() {
      document.getElementById('cart-count').textContent = cart.reduce((a, b) => a + b.qty, 0);

      let html = '';
      let total = 0;

      cart.forEach((item, index) => {
        const itemTotal = item.price * item.qty;
        total += itemTotal;
        html += `
          <div class="flex justify-between items-center mb-6 bg-gray-50 p-4 rounded-2xl">
            <div>
              <p class="font-medium">${item.name}</p>
              <p class="text-sm text-gray-500">฿${item.price} × ${item.qty}</p>
            </div>
            <div class="text-right">
              <p class="font-bold">฿${itemTotal}</p>
              <div class="flex items-center gap-3 mt-2">
                <button onclick="changeQty(${index}, -1)" class="w-7 h-7 bg-white rounded-lg shadow text-lg">-</button>
                <span class="font-semibold w-6 text-center">${item.qty}</span>
                <button onclick="changeQty(${index}, 1)" class="w-7 h-7 bg-white rounded-lg shadow text-lg">+</button>
              </div>
            </div>
          </div>
        `;
      });

      document.getElementById('cart-items').innerHTML = html || 
        '<p class="text-center text-gray-400 py-20">ยังไม่มีสินค้าในตะกร้า</p>';
      document.getElementById('cart-total').textContent = `฿${total}`;
    }

    function changeQty(index, delta) {
      cart[index].qty += delta;
      if (cart[index].qty < 1) cart.splice(index, 1);
      updateCart();
    }

    function toggleCart(show = true) {
      document.getElementById('cart-drawer').classList.toggle('hidden', !show);
    }

    function checkout() {
      if (cart.length === 0) return;
      
      let message = "สนใจสั่งซื้อ Ready Taan\n\n";
      cart.forEach(item => {
        message += `- ${item.name} x${item.qty}\n`;
      });
      message += `\nยอดรวม: ${document.getElementById('cart-total').textContent}\nส่งฟรีทุกออเดอร์`;

      const encoded = encodeURIComponent(message);
      window.open(`https://line.me/R/ti/p/@226sbiwm?text=${encoded}`, '_blank');
      
      cart = [];
      updateCart();
      toggleCart(false);
    }
  </script>
</body>
</html>
