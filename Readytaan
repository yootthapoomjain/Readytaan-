<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ready Taan - เครื่องดื่มธัญพืชเพื่อสุขภาพ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap');
    body { font-family: 'Inter', system-ui, sans-serif; }
    .serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-gray-50">

  <!-- Promo Bar -->
  <div class="bg-amber-600 text-white text-center py-3 text-sm font-medium">
    🚚 ส่งฟรีทุกออเดอร์ • ซื้อ 3 ถุง แถมแก้วเชค Premium
  </div>

  <!-- Navigation -->
  <nav class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-amber-600 serif">Ready Taan</h1>
      <button onclick="toggleCart()" class="relative">
        <i class="fas fa-shopping-cart text-2xl"></i>
        <span id="cart-count" class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span>
      </button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-amber-50 to-white py-16">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h2 class="text-5xl font-bold serif leading-tight mb-4">เครื่องดื่มธัญพืช<br>4 ชนิด เพื่อสุขภาพ</h2>
      <p class="text-lg text-gray-600 mb-8">ชงง่าย อร่อย อิ่มนาน 100% ธรรมชาติ</p>
      <button onclick="document.getElementById('shop').scrollIntoView({behavior:'smooth'})" 
              class="bg-amber-600 text-white px-10 py-4 rounded-full text-lg font-semibold">
        สั่งซื้อเลย
      </button>
    </div>
  </section>

  <!-- Products -->
  <section id="shop" class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-3xl font-bold text-center mb-10">เลือกแพ็กเกจ</h2>
    
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Product 1 -->
      <div class="bg-white rounded-3xl shadow-lg overflow-hidden">
        <img src="https://i.ibb.co/gZkTL9Qp/AA6-E1-C71-0-C44-4664-BE62-D018-B130-D86-F.png" class="w-full h-64 object-contain bg-gray-100">
        <div class="p-6">
          <h3 class="text-xl font-semibold">Ready Taan 1 ถุง</h3>
          <p class="text-gray-500">250 g.</p>
          <div class="flex justify-between items-end mt-6">
            <div>
              <span class="text-3xl font-bold text-amber-600">฿290</span>
            </div>
            <button onclick="addToCart(0)" class="bg-amber-600 text-white px-6 py-3 rounded-2xl">เพิ่มลงตะกร้า</button>
          </div>
        </div>
      </div>

      <!-- Product 2 -->
      <div class="bg-white rounded-3xl shadow-lg overflow-hidden border-2 border-amber-500 relative">
        <div class="absolute top-4 right-4 bg-amber-500 text-white text-xs font-bold px-4 py-1 rounded-full">แนะนำ</div>
        <img src="https://via.placeholder.com/600x400/fff3e0/000?text=3+ถุง+%2B+แก้ว" class="w-full h-64 object-contain bg-gray-100">
        <div class="p-6">
          <h3 class="text-xl font-semibold">Ready Taan 3 ถุง + แก้วเชค</h3>
          <p class="text-gray-500">ส่งฟรี</p>
          <div class="flex justify-between items-end mt-6">
            <div>
              <span class="text-3xl font-bold text-amber-600">฿870</span>
            </div>
            <button onclick="addToCart(1)" class="bg-amber-600 text-white px-6 py-3 rounded-2xl">เพิ่มลงตะกร้า</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cart Drawer -->
  <div id="cart-drawer" class="fixed inset-0 bg-black/50 hidden flex items-end z-50">
    <div class="bg-white w-full max-w-md mx-auto rounded-t-3xl h-[85vh] flex flex-col">
      <div class="p-6 border-b flex justify-between items-center">
        <h3 class="text-2xl font-semibold">ตะกร้าสินค้า</h3>
        <button onclick="toggleCart()" class="text-3xl">✕</button>
      </div>
      
      <div id="cart-items" class="flex-1 p-6 overflow-auto"></div>
      
      <div class="p-6 border-t">
        <div class="flex justify-between text-xl mb-6">
          <span>ยอดรวม</span>
          <span id="cart-total" class="font-bold">฿0</span>
        </div>
        <button onclick="checkout()" class="w-full bg-green-600 text-white py-4 rounded-2xl text-lg font-semibold">สั่งซื้อผ่าน LINE</button>
      </div>
    </div>
  </div>

  <script>
    let cart = [];

    function addToCart(index) {
      const products = [
        { name: "Ready Taan 1 ถุง", price: 290 },
        { name: "Ready Taan 3 ถุง + แก้วเชค", price: 870 }
      ];
      
      const existing = cart.find(item => item.name === products[index].name);
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({ ...products[index], qty: 1 });
      }
      updateCart();
      toggleCart(true);
    }

    function updateCart() {
      document.getElementById('cart-count').textContent = cart.reduce((a, c) => a + c.qty, 0);
      
      let html = '';
      let total = 0;
      
      cart.forEach((item, i) => {
        total += item.price * item.qty;
        html += `
          <div class="flex gap-4 mb-6">
            <div class="flex-1">
              <p class="font-medium">${item.name}</p>
              <p class="text-sm text-gray-500">฿${item.price} × ${item.qty}</p>
            </div>
            <div class="text-right">
              <p class="font-bold">฿${item.price * item.qty}</p>
              <button onclick="changeQty(${i}, -1)" class="text-red-500 text-xl">-</button>
              <span class="mx-2">${item.qty}</span>
              <button onclick="changeQty(${i}, 1)" class="text-green-500 text-xl">+</button>
            </div>
          </div>
        `;
      });
      
      document.getElementById('cart-items').innerHTML = html || '<p class="text-center text-gray-400 py-10">ยังไม่มีสินค้า</p>';
      document.getElementById('cart-total').textContent = `฿${total}`;
    }

    function changeQty(i, delta) {
      cart[i].qty += delta;
      if (cart[i].qty < 1) cart.splice(i, 1);
      updateCart();
    }

    function toggleCart(open) {
      const drawer = document.getElementById('cart-drawer');
      drawer.classList.toggle('hidden', !open);
    }

    function checkout() {
      if (cart.length === 0) return;
      
      let text = "สนใจสั่งซื้อ Ready Taan\n\n";
      cart.forEach(item => {
        text += `- ${item.name} x${item.qty}\n`;
      });
      text += `\nยอดรวม: ฿${document.getElementById('cart-total').textContent.replace('฿','')}\nส่งฟรี`;
      
      const encoded = encodeURIComponent(text);
      window.open(`https://line.me/R/ti/p/@226sbiwm?text=${encoded}`, '_blank');
      
      cart = [];
      updateCart();
      toggleCart(false);
    }
  </script>
</body>
</html>
